# Where the browser sends API calls. Defaults to "/api" (same-origin, proxied in dev).
# Set this only if you need to bypass the dev proxy and hit the backend directly.
# VITE_API_BASE_URL=http://localhost:4000/api

# Where the Vite dev proxy forwards /api. Read at config time, not in the browser.
# VITE_API_ORIGIN=http://localhost:4000
