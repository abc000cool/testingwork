# Copy to .env. `npm run dev` loads it automatically.

PORT=4000
HOST=127.0.0.1

# JSON snapshot file. Set to an empty value for a throwaway in-memory database.
DATA_FILE=data/db.json

# How long a session token stays valid.
SESSION_TTL_HOURS=168

# Comma-separated allowlist, or "*" to reflect whatever Origin is sent (dev only).
CORS_ORIGINS=*

# Failed-attempt throttling on /api/auth/signup and /api/auth/login, per IP.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Set true only when running behind a proxy that sets X-Forwarded-For.
TRUST_PROXY=false
